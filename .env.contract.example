# Google カレンダーとの契約テストの設定
#
# このファイルを .env.contract にコピーして値を入れる（.env.contract は git に入らない）。
#   cp .env.contract.example .env.contract
# 入れたら次で流す。環境変数が設定されていれば、そちらが優先される。
#   cargo test --all-features contract_tests -- --ignored

# テスト用カレンダーのID（カレンダーの「設定と共有」→「カレンダーの統合」→「カレンダーID」）
LRM_CONTRACT_CALENDAR_ID=

# サービスアカウントの鍵ファイル（JSON）のパス。リポジトリ直下からの相対パスでよい。
# secrets/ の下に置けば git に入らない
LRM_CONTRACT_SERVICE_ACCOUNT_KEY=secrets/contract-service-account.json
